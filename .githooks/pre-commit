#!/bin/sh
# Created: 2026-10-22 12:20 -05:00 · Edited: 2026-10-22 12:20 -05:00
# pre-commit — the gates, run after the last edit. Upstream checks (stamps, status
# page, citations, register shape) need the turing-review clone; without it they are
# skipped LOUDLY, never silently (RR2). The project's own run and floor always run.
set -eu
cd "$(git rev-parse --show-toplevel)"
TR="${TURING_REVIEW:-$HOME/Local_Dev_Projects/turing-review}"
if [ -d "$TR/scripts" ]; then
  python3 "$TR/scripts/stamp.py" --check
  python3 "$TR/scripts/gen_status.py" . --check
  python3 "$TR/scripts/check_citations.py" .
  python3 "$TR/scripts/check_register.py" docs/plans/00-register.md
else
  echo "pre-commit: upstream not found at $TR — stamp, status, citation and register checks SKIPPED (RR2)"
fi
scripts/run_tests.sh
scripts/check_floor.sh
